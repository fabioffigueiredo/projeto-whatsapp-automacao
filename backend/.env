# ===========================================================================
# CONFIGURAÇÕES DO DJANGO
# ===========================================================================
# ATENÇÃO: Nunca commite este arquivo com valores reais!
# Copie este arquivo para .env e preencha com suas credenciais reais.
# O arquivo .env está no .gitignore e NÃO deve ser versionado.
# ===========================================================================
DJANGO_SECRET_KEY=sua-secret-key-django-aqui-use-openssl-rand-hex-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================================================
# BANCO DE DADOS
# ===========================================================================
# Para desenvolvimento use SQLite: sqlite:///db.sqlite3
# Para produção use PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Configurações PostgreSQL (opcional)
POSTGRES_DB=whatsapp_db
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_segura
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================================================================
# CONFIGURAÇÕES DO WHATSAPP CLOUD API
# Obtenha em: https://developers.facebook.com/ -> Seu App -> WhatsApp -> Configuration
# ===========================================================================
WHATSAPP_ACCESS_TOKEN=seu_token_de_acesso_whatsapp_aqui
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id
WHATSAPP_APP_ID=seu_app_id
WHATSAPP_APP_SECRET=seu_app_secret
WHATSAPP_WEBHOOK_URL=https://seu-dominio.com/api/webhook/
WHATSAPP_API_VERSION=v18.0

# ===========================================================================
# CONFIGURAÇÕES DE PAGAMENTO (Gateway)
# ===========================================================================
PAYMENT_API_KEY=sua_chave_api_pagamento
PAYMENT_SECRET_KEY=sua_secret_key_pagamento
PAYMENT_WEBHOOK_SECRET=seu_webhook_secret_pagamento

# ===========================================================================
# API DE CÂMBIO
# ===========================================================================
EXCHANGE_RATE_API_KEY=sua_chave_api_cambio
