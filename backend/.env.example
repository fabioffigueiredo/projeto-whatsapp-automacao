# ============================================================================
# CONFIGURAÇÕES DO DJANGO
# ============================================================================
DJANGO_SECRET_KEY=changeme-super-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# BANCO DE DADOS (PostgreSQL)
# ============================================================================
POSTGRES_DB=adminbot_db
POSTGRES_USER=adminbot_user
POSTGRES_PASSWORD=changeme-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================================
# CONFIGURAÇÕES DO N8N
# ============================================================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-n8n-password
N8N_PORT=5678
N8N_HOST=localhost

# ============================================================================
# CONFIGURAÇÕES DE API INTERNA
# ============================================================================
API_BASE_URL=http://backend:8000/api
API_TOKEN=changeme-api-token

# ============================================================================
# WHATSAPP BUSINESS API
# ============================================================================
# Token de acesso permanente do WhatsApp Business API
# Obtenha em: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# ID do número de telefone do WhatsApp Business
# Encontre em: WhatsApp Business Account > Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ID da conta comercial do WhatsApp
# Encontre em: Business Manager > WhatsApp Business Accounts
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ID do aplicativo Facebook
# Encontre em: https://developers.facebook.com/apps/
WHATSAPP_APP_ID=your_facebook_app_id

# Chave secreta do aplicativo Facebook
# Encontre em: App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=your_facebook_app_secret

# Token de verificação do webhook (defina um valor único)
WHATSAPP_VERIFY_TOKEN=your_unique_webhook_verify_token

# URL do webhook (seu domínio + /api/webhook/whatsapp)
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/webhook/whatsapp

# Versão da API do WhatsApp (recomendado: v18.0 ou superior)
WHATSAPP_API_VERSION=v18.0

# ============================================================================
# EMAIL (opcional, para notificações do sistema)
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=changeme-email-pass
EMAIL_USE_TLS=True

# Lista de emails para notificações de erro (separados por vírgula)
ADMIN_NOTIFICATION_EMAILS=admin@your-domain.com,tech@your-domain.com

# ============================================================================
# CONFIGURAÇÕES DE PAGAMENTO
# ============================================================================
# Provedor de pagamento (stripe, mercadopago, etc.)
PAYMENT_PROVIDER=stripe

# Chaves da API de pagamento
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# URLs de pagamento
PAYMENT_WEBHOOK_URL=https://your-domain.com/api/payment-webhook
PAYMENT_SUCCESS_URL=https://your-domain.com/payment/success
PAYMENT_CANCEL_URL=https://your-domain.com/payment/cancel

# ============================================================================
# APIS EXTERNAS
# ============================================================================
# API de cotação de moedas (Fixer.io)
FIXER_API_KEY=your_fixer_api_key

# API XPS247 (se aplicável)
XPS247_API_KEY=your_xps247_api_key
XPS247_BASE_URL=https://api.xps247.com

# ============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ============================================================================
# Configurações de segurança para produção
# Descomente e configure quando for para produção:

# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# X_FRAME_OPTIONS=DENY