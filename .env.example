# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
DATABASE_URL=sqlite:///db.sqlite3

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/webhook/whatsapp/

# Payment Provider
PAYMENT_PROVIDER_URL=https://payment-provider.com
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# XPS247 Integration
XPS247_API_URL=https://api.xps247.com
XPS247_API_KEY=your-xps247-api-key

# External APIs
FIXER_API_KEY=your-fixer-api-key

# n8n Configuration
N8N_USER=admin
N8N_PASSWORD=your-secure-password
N8N_WEBHOOK_URL=http://localhost:5678

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn